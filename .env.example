TELEGRAM_BOT_TOKEN=123456:replace-me
WEBHOOK_SECRET=local-dev-secret-16chars
# Optional locally; on Render, RENDER_EXTERNAL_URL is set automatically
# WEBHOOK_URL=https://your-service.onrender.com
PORT=3000
NODE_ENV=development

# OpenRouter — create keys at https://openrouter.ai/settings/keys
# Multiple keys (comma-separated) rotate on rate limits:
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
# Or a single key:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=poolside/laguna-s-2.1:free
