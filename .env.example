TELEGRAM_BOT_TOKEN=123456:replace-me
WEBHOOK_SECRET=local-dev-secret-16chars
# Optional locally; on Render, RENDER_EXTERNAL_URL is set automatically
# WEBHOOK_URL=https://your-service.onrender.com
PORT=3000
NODE_ENV=development

# LLM providers (need at least one). Failover: Groq → Gemini → OpenRouter (last).
# Prefer GROQ_API_KEY and/or GEMINI_API_KEY for snappy replies; OpenRouter free is slow.
# Groq GPT-OSS: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini Flash: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter free (comma-separated, last resort): https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Cloudflare Workers AI images (FLUX.2-dev via gosha-flux proxy or direct API token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_GATEWAY_URL=https://gosha-flux.<subdomain>.workers.dev
